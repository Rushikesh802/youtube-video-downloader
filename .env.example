# Application Environment
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1
PROJECT_NAME="YouTube & Media Downloader Platform"

# Security & Authentication
# Generate a secure secret using: openssl rand -hex 32
SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=media_downloader
# Async URL used by FastAPI SQLAlchemy
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/media_downloader
# Sync URL used by Alembic migrations
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/media_downloader

# Redis Broker & Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Object Storage (MinIO locally / AWS S3 in production)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=media-downloads
S3_REGION=us-east-1
S3_PRESIGNED_EXPIRATION_SECONDS=900

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Media Processing Limits
MAX_MEDIA_DURATION_SECONDS=1800
MAX_DOWNLOAD_FILE_SIZE_BYTES=524288000
MAX_USER_CONCURRENT_JOBS=2
DOWNLOAD_EXPIRATION_HOURS=24
